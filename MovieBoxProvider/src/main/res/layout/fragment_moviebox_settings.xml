<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="11sp"
                    android:textColor="#ff888888"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MovieBox"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1">
                </TextView>
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Settings">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/saveContainer"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="44dp"
                android:layout_height="44dp">
                <ImageView
                    android:id="@+id/saveIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Save &amp; Reload">
                </ImageView>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="#1fffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
        </View>
        <TextView
            android:textSize="11sp"
            android:textColor="#ff888888"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server &amp; API"
            android:textAllCaps="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:letterSpacing="0.08">
        </TextView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/hostRow"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/host_container"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:id="@+id/hostIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:tint="#ff4d88ff"
                    android:contentDescription="API Host">
                </ImageView>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API Host">
                </TextView>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff888888"
                    android:id="@+id/hostSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Select the backend server for MovieBox API">
                </TextView>
            </LinearLayout>
            <ImageView
                android:id="@+id/chevron_host"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:alpha="0.5">
            </ImageView>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="#ff888888"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Page"
            android:textAllCaps="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:letterSpacing="0.08">
        </TextView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sectionsRow"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/sections_container"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:id="@+id/sectionsIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Manage Sections">
                </ImageView>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage Sections">
                </TextView>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff888888"
                    android:id="@+id/sectionsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Reorder or hide home page sections">
                </TextView>
            </LinearLayout>
            <ImageView
                android:id="@+id/chevron_sections"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:alpha="0.5">
            </ImageView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
